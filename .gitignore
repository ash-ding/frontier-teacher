# outputs/ is both the working directory that evaluate.py writes to and the
# record of what was measured - there is no second copy to drift out of sync.
# Track summaries and per-problem records; leave out what is either huge or an
# intermediate. A re-run that changes a result shows up in `git status`.
#
# Benchmark runs land at the top level; training-pool profiling runs land in
# math_profiling/, whose records are 12-36 MB and stay untracked.
outputs/*
!outputs/*.summary.json
!outputs/*.records.jsonl
# shard intermediates, superseded by the merged file
outputs/*__s[0-9]of[0-9].*
outputs/shards/

# profiling: keep the summaries, leave the bulk on the compute nodes
!outputs/math_profiling/
outputs/math_profiling/*
!outputs/math_profiling/*.summary.json
outputs/math_profiling/*__s[0-9]of[0-9].summary.json

# Raw generations: ~880 MB per model. Live on the compute nodes under
# $HOME/data/frontier-teacher/generations/.
generations/

# Evaluation and training data ARE tracked. Pinning the exact problem set is
# what makes a score comparable across runs and across time - an upstream
# revision must not silently change what was measured. The builders in data/
# stay as the reproducibility check: re-running them should reproduce these
# files byte for byte.

# Environment / local noise
.secrets/
logs/
.venv/
__pycache__/
*.pyc
.DS_Store

# scratch: cross-validation reruns during the environment migration
outputs_xval/

# verl-format conversions of the subsets; regenerate with src/to_verl_dataset.py
*.verl.jsonl
outputs/checkpoints/

# third_party/ holds a read-only snapshot of verl's source, fetched by
# scripts/fetch_verl_source.sh at the commit pinned in third_party/verl.lock.
# The pin reconstructs it byte for byte, so committing 8.3 MB across 362 files
# would only bury this repository's own history in git log and git grep.
# The lock file itself IS tracked - it is the pin.
third_party/*
!third_party/verl.lock
