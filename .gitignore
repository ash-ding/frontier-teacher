# outputs/ is a symlink to ~/data/frontier-teacher/outputs on the shared bucket,
# so all three nodes read and write one set of results. Results are therefore
# durable on 1 PB of object storage rather than on a container disk, and git no
# longer needs to carry 30 MB of them. Cross-node visibility is eventual: a file
# written on one node takes minutes to appear on another. Same-node
# read-after-write is immediate, which is what the evaluation scripts rely on.
#
# outputs/ was tracked before this. That history is intact; results committed up
# to then are still in the repository.
outputs
outputs.bak
.local_checkpoints/

# Raw generations: ~880 MB per model. Live on the compute nodes under
# $HOME/data/frontier-teacher/generations/.
generations/

# Evaluation and training data ARE tracked. Pinning the exact problem set is
# what makes a score comparable across runs and across time - an upstream
# revision must not silently change what was measured. The builders in data/
# stay as the reproducibility check: re-running them should reproduce these
# files byte for byte.

# Environment / local noise
.secrets/
logs/
.venv/
__pycache__/
*.pyc
.DS_Store

# scratch: cross-validation reruns during the environment migration
outputs_xval/

# verl-format conversions of the subsets; regenerate with train/grpo/to_verl_dataset.py
*.verl.jsonl

# package/ holds a read-only snapshot of verl's source, fetched by
# scripts/fetch_verl_source.sh at the commit pinned in package/verl.lock.
# The pin reconstructs it byte for byte, so committing 8.3 MB across 362 files
# would only bury this repository's own history in git log and git grep.
# The lock file itself IS tracked - it is the pin.
package/*
!package/verl.lock
